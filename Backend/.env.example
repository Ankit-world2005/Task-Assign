# US24 Solutions Backend Environment Configuration
# Copy this file to .env and adjust values for production / external PostgreSQL

DEBUG=True
DJANGO_SECRET_KEY=us24_solutions_secret_key_change_in_production_2026

# External PostgreSQL Database Credentials
# Set DB_ENGINE=postgres to enable PostgreSQL (e.g. Supabase, AWS RDS, Neon, Hostinger)
DB_ENGINE=postgres
DB_NAME=us24_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
