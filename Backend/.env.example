# US24 Solutions backend (Node.js + Express) configuration
# Copy this file to .env and adjust the values. Every setting is optional.

# True shows error messages in 500 responses
DEBUG=True
# The Vite dev server proxies /api to http://127.0.0.1:8001
PORT=8001

# Database: the SQLite file Backend/db.sqlite3 is used by default.
# To use PostgreSQL instead (e.g. Supabase, AWS RDS, Neon, Hostinger), uncomment these lines.
# Setting DB_ENGINE=postgres or DB_NAME switches to PostgreSQL; the tables are created on first start.
# DB_ENGINE=postgres
# DB_NAME=us24_db
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_HOST=localhost
# DB_PORT=5432

# Security
# Testing aid only: True shows the login code on the login page. Keep False (or leave out) in real use.
SHOW_OTP_ON_SCREEN=False
# Other browser addresses allowed to call the API (comma-separated), e.g. a deployed frontend URL.
# Default: http://localhost:5173, http://127.0.0.1:5173 and the :3000 / :8000 equivalents.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# True when the site is served over HTTPS, so the login cookie is only sent over HTTPS.
SESSION_COOKIE_SECURE=False

# Gmail SMTP for the login OTP emails. Leave the user/password empty to print OTP emails in the server window.
# Gmail needs 2-Step Verification and a 16-character App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=US24 Portal Security <no-reply@us24solutions.com>
