# US24 Solutions Backend Environment Configuration
DEBUG=True
DJANGO_SECRET_KEY=us24_solutions_secret_key_change_in_production_2026

# Gmail SMTP 2-Step Verification Configuration
# To send actual OTP emails to your Gmail inbox:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and the 16-character App Password below:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="US24 Security Team <no-reply@us24solutions.com>"
